/english-wonderland/images/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/english-wonderland/audio/*
  Cache-Control: public, max-age=31536000, immutable

/english-wonderland/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/poetry-garden/images/*
  Cache-Control: public, max-age=31536000, immutable

/poetry-garden/audio/*
  Cache-Control: public, max-age=0, must-revalidate

# HTML 文档必须每次重新校验，否则浏览器会启发式缓存旧 index.html，
# 导致音频引用停留在被污染的空缓存版本、朗读回退到浏览器 TTS。
/poetry-garden/*
  Cache-Control: no-store, no-cache, must-revalidate

# english-wonderland 单文件应用（JS 内联在 index.html），同样必须 no-store；
# images/audio/assets 的 immutable 规则靠最长前缀匹配仍生效。
/english-wonderland/*
  Cache-Control: no-store, no-cache, must-revalidate

# month-menu 单文件应用（JS 内联），必须 no-store，否则浏览器启发式缓存旧页，
# 修复（如截图 base64 撑爆 localStorage）到不了用户。
/month-menu/*
  Cache-Control: no-store, no-cache, must-revalidate
