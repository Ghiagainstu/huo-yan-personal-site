# ============================================================
# 火哥的个人站 · Cache-Control 策略
# ⚠️ 关键教训（2026-08-22）：HTML 的 no-store 规则绝不能用 /* 通配，
# 否则会与 images/audio 的长缓存规则合并生效（实测响应头同时出现
# "max-age=31536000..., no-store" → no-store 在场 → 静态资源从不缓存，
# 每次播放/加载全量走海外下载）。HTML 规则必须用 *.html 精确匹配。
# ============================================================

# english-wonderland 静态资源：长缓存（immutable，改图后升文件名版本号破缓存）
/english-wonderland/images/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

/english-wonderland/audio/*
  Cache-Control: public, max-age=31536000, immutable

/english-wonderland/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# poetry-garden 静态资源
/poetry-garden/images/*
  Cache-Control: public, max-age=31536000, immutable

# poetry-garden 音频刻意 must-revalidate（升文件名版本号破缓存，勿改长缓存）
/poetry-garden/audio/*
  Cache-Control: public, max-age=0, must-revalidate

# ---------- HTML 文档：必须 no-store（避免浏览器启发式缓存旧页） ----------
# 只匹配 .html 文件，绝不匹配 images/audio/assets 子路径（前缀合并污染坑）

/poetry-garden/*.html
  Cache-Control: no-store, no-cache, must-revalidate

/english-wonderland/*.html
  Cache-Control: no-store, no-cache, must-revalidate

/month-menu/*.html
  Cache-Control: no-store, no-cache, must-revalidate

/index.html
  Cache-Control: no-store, no-cache, must-revalidate
